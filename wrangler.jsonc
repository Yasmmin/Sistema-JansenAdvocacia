{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jansen-djen-monitor",
	"main": "server/worker.ts",
	"compatibility_date": "2026-05-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"GOOGLE_CALENDAR_WEBHOOK_URL": "https://jansen-djen-monitor.yasmmin.workers.dev/api/calendar/google/webhook",
		"GOOGLE_CALENDAR_INCLUDED_IDS": "francisco@jansenadvocacia.com.br",
		"GOOGLE_CALENDAR_DEFAULT_ID": "francisco@jansenadvocacia.com.br"
	},
	"triggers": {
		"crons": ["*/30 * * * *", "0 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jansen-djen",
			"database_id": "0c292173-9093-4a1c-8771-1c01c179131f",
			"migrations_dir": "drizzle"
		}
	]
}
